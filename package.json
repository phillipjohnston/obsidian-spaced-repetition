{
    "name": "obsidian-note-review",
    "version": "1.0.0",
    "description": "Note review, anti-srs, incremental writing",
    "main": "main.js",
    "scripts": {
        "build": "node esbuild.config.mjs production",
        "dev": "node esbuild.config.mjs",
        "format": "npx prettier --write .",
        "lint": "npx prettier --check . && npx eslint src/",
        "test": "jest",
        "changelog": "auto-changelog --template=compact --package && npx prettier --write CHANGELOG.md",
        "e2e": "make setup_e2e && wdio run ./wdio.conf.js"
    },
    "keywords": [
        "obsidian",
        "spaced-repetition",
        "flashcards"
    ],
    "author": "Phillip Johnston",
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.5.3",
        "@types/node": "^20.4.10",
        "@typescript-eslint/eslint-plugin": "^6.3.0",
        "@typescript-eslint/parser": "^6.3.0",
        "@wdio/cli": "^9.21.1",
        "@wdio/local-runner": "^9.21.0",
        "@wdio/mocha-framework": "^9.21.0",
        "@wdio/spec-reporter": "^9.20.0",
        "auto-changelog": "^2.4.0",
        "builtin-modules": "^3.3.0",
        "chai": "^4.3.7",
        "esbuild": "^0.27.1",
        "eslint": "^8.47.0",
        "jest": "^29.6.2",
        "jest-environment-jsdom": "^29.6.2",
        "jest-expect-message": "^1.1.3",
        "obsidian": "^1.4.0",
        "prettier": "^3.0.1",
        "ts-jest": "^29.1.1",
        "tslib": "2.6.1",
        "typescript": "5.1.6"
    },
    "dependencies": {
        "pagerank.js": "^1.0.2"
    },
    "packageManager": "npm@8.18.0"
}
